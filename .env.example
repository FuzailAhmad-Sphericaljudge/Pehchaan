# Never use demo OTP in production.
NODE_ENV=development
ALLOW_DEMO_OTP=true

# Required in production.
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL or Supabase connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/pehchaan

# Configure one provider for production OTP delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Or use MSG91 instead of Twilio.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Demo NGO credentials for local development only.
NGO_DEMO_EMAIL=ngo@pehchaan.org
NGO_DEMO_PASSWORD=demo
