# PostgreSQL or Supabase connection string.
DATABASE_URL=postgresql://postgres:Qwertyuio786!%40%23%24@db.pzcfuapfdphljohzcnrn.supabase.co:5432/postgres

# Configure one provider for production OTP delivery.
